{
  "name": "ex-libris",
  "private": true,
  "version": "0.1.0",
  "description": "Ex Libris \u2014 a local, AI-assisted novel-writing studio",
  "author": "Ex Libris",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "dev:desktop": "concurrently -k \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "start:desktop": "npm run build && npm run rebuild:electron && electron .",
    "poststart:desktop": "npm run rebuild:node",
    "dist": "npm run build && electron-builder",
    "postdist": "npm run rebuild:node",
    "dist:dir": "npm run build && electron-builder --dir",
    "postdist:dir": "npm run rebuild:node",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tiptap/extension-color": "^2.11.2",
    "@tiptap/extension-font-family": "^2.11.2",
    "@tiptap/extension-heading": "^2.11.2",
    "@tiptap/extension-highlight": "^2.11.2",
    "@tiptap/extension-placeholder": "^2.11.2",
    "@tiptap/extension-text-align": "^2.11.2",
    "@tiptap/extension-text-style": "^2.11.2",
    "@tiptap/extension-underline": "^2.11.2",
    "@tiptap/react": "^2.11.2",
    "@tiptap/starter-kit": "^2.11.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "docx": "^9.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
