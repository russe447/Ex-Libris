# .gitignore
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build outputs
release/
*.tsbuildinfo
server/*.db
server/*.db-shm
server/*.db-wal

# AES key that encrypts stored API keys. Lives in the app data directory
# now (see server/paths.js); these patterns also cover stale repo copies.
server/.secret
.secret
*.db
*.db-wal
*.db-shm
